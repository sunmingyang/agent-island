<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentIsland</RootNamespace>
    <AssemblyName>AgentIsland</AssemblyName>
    <Version>1.5.6</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon Condition="Exists('Assets\AgentIsland.ico')">Assets\AgentIsland.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>

  <!-- Let the console test suite reach internal validation/parse helpers. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentIsland.Tests" />
  </ItemGroup>

  <!-- WinForms is referenced only for the tray NotifyIcon; keep its
       namespaces out of the global usings so WPF's Color/Size/Application
       win unqualified. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
